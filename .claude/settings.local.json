{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm build:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(npm run build:*)",
      "Bash(find:*)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot"
